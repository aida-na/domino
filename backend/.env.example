# Database (Supabase — separate project from daily/loteria)
DATABASE_URL=postgresql+asyncpg://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# AI
GEMINI_API_KEY=

# Twilio / WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Internal secret (for digest trigger endpoint / GitHub Actions)
DOMINO_INTERNAL_SECRET=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=Domino <noreply@resend.dev>

# Google Cloud Storage (image/media storage)
GCS_BUCKET_NAME=
GCS_SERVICE_ACCOUNT_JSON=

# CORS / frontend URL
FRONTEND_URL=https://domino.app
BACKEND_CORS_ORIGINS=["http://localhost:3000","https://domino.app","https://www.domino.app"]

# Security
SECRET_KEY=change-me-in-production
DEBUG=false
