# Environment: development | staging | production
ENVIRONMENT=development

# Database — local dev defaults to SQLite (see config.py); prod uses Cloud SQL
# DATABASE_URL=sqlite+aiosqlite:///./domino.db
# Cloud Run (Unix socket via Cloud SQL connector):
# DATABASE_URL=postgresql+asyncpg://USER:PASS@/domino?host=/cloudsql/PROJECT:REGION:INSTANCE

# AI
GEMINI_API_KEY=

# Blooio (iMessage / SMS) — https://dashboard.blooio.com
# Webhook URL: POST /api/v1/sms  (webhook_type: message or all)
# Assign senders under Channels (drag number onto the API key) — not always under Numbers.
BLOOIO_API_KEY=
# Optional. Leave blank to let Blooio auto-select from the key's Channels pool.
BLOOIO_PHONE_NUMBER=+14249441140
# signing_secret shown once when creating the webhook (X-Blooio-Signature)
BLOOIO_WEBHOOK_SECRET=

# Internal secret (for digest trigger endpoint / GitHub Actions)
# GitHub Actions secret must be named DOMINO_INTERNAL_SECRET and sent as X-Internal-Secret
DOMINO_INTERNAL_SECRET=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=Domino <noreply@resend.dev>

# Google Cloud Storage (image/media storage)
GCS_BUCKET_NAME=
# Optional locally; on Cloud Run use the attached service account instead (no JSON key).
GCS_SERVICE_ACCOUNT_JSON=

# CORS / frontend URL
# Use www until apex→www redirect is removed in Vercel (Apple AASA forbids redirects).
FRONTEND_URL=https://www.domino.fyi
BACKEND_CORS_ORIGINS=["http://localhost:3000","https://domino.fyi","https://www.domino.fyi"]

# Max new accounts per UTC day (invites included). Set 0 for unlimited.
DAILY_NEW_USER_LIMIT=5

# Security
SECRET_KEY=change-me-in-production
DEBUG=false
# Required in production: BLOOIO_WEBHOOK_SECRET, DOMINO_INTERNAL_SECRET
