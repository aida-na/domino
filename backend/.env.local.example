# Copy to .env.local and merge into .env for local backend QA (never commit .env).
# Simulator / web: NEXT_PUBLIC_API_URL=http://localhost:8000 in frontend/.env.local
# iOS Debug: uncomment API_BASE_URL in ios/Config/Debug.xcconfig → http://127.0.0.1:8000/api/v1

ENVIRONMENT=development
DEBUG=true
DAILY_NEW_USER_LIMIT=0
FRONTEND_URL=http://localhost:3000

# Local SQLite won't apply Postgres schema — use Cloud SQL Auth Proxy instead:
#   cloud-sql-proxy domino-500918:us-central1:domino-db --port 5433
# DATABASE_URL=postgresql+asyncpg://USER:PASS@127.0.0.1:5433/domino

# Leave Blooio empty to print OTP/magic links in the uvicorn console (DEBUG=true shows body):
BLOOIO_API_KEY=
BLOOIO_WEBHOOK_SECRET=
